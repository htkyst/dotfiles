/* Wallpaper book: launch with scripts/wallpaper.sh. */
configuration {
    show-icons: true;
    font: "Noto Serif 13";
}
* {
    background-color: transparent;
    background-image: none;
    text-color: #493522;
}
window {
    width: 80%;
    height: 80%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: #b49a73;
    border-radius: 12px;
    background-color: #efe2c5;
    background-image: url("~/page.png", both);
}
mainbox {
    orientation: vertical;
    padding: 6% 10%;
    spacing: 16px;
    children: [ textbox-title, listview, textbox-help ];
}
textbox-title {
    expand: false;
    content: "WALLPAPER BOOK";
    font: "Noto Serif 22";
    horizontal-align: 0.5;
}
listview {
    layout: horizontal;
    lines: 1;
    columns: 1;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    cycle: true;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    padding: 12px;
    spacing: 12px;
    border: 1px;
    border-color: #b49a73;
    border-radius: 4px;
    background-color: #fff9ec;
}
element selected.normal {
    background-color: #fff9ec;
    text-color: #493522;
}
element-icon {
    expand: true;
    size: 28ch;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
element-text {
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
textbox-help {
    expand: false;
    content: "← / →  Previous / Next page     Enter  Apply     Esc  Close";
    horizontal-align: 0.5;
    font: "Noto Serif 11";
}
